maven.ignoreSourceFiles=true
maven.ignoreMvnTreeErrors=false
maven.aggregateModules=true
maven.ignorePomModules=false
maven.ignoredScopes=test,provided,system

maven.runPreStep=true
maven.additionalArguments=-DskipTests

excludes=**/tools/**, **/gluten-ut/**, **/gluten-celeborn/**, **/gluten-kafka/**, **/gluten-uniffle/**, **/cpp-ch/**, **/backends-clickhouse/**, **/dev/**, **/shims/spark32/**, **/shims/spark33/**, **/gluten-flink/**, **/gluten-paimon/**, **/tools/gluten-it/**

python.path=python3.12
python.invokePipAsModule=true